# Скопируйте в .env. Не публикуйте токен и не присылайте его в чат.
BOT_TOKEN=123456789:replace_with_token_from_BotFather
# Telegram user ID владельцев, через запятую. Только они могут /reload_channels.
ADMIN_USER_IDS=
CHANNELS_FILE=./config/channels.json

# Небольшой VPS: начинайте с одной задачи. Очередь хранится в памяти.
DOWNLOAD_CONCURRENCY=1
MAX_QUEUE_SIZE=20
USER_COOLDOWN_SECONDS=15
MAX_DURATION_SECONDS=1200
MAX_VIDEO_HEIGHT=720
MAX_UPLOAD_MB=49
MAX_JOB_DISK_MB=250
MIN_FREE_DISK_MB=512
JOB_TIMEOUT_SECONDS=600
PROCESS_TIMEOUT_SECONDS=180
TELEGRAM_TIMEOUT_SECONDS=180
SESSION_TTL_SECONDS=86400
SUBSCRIPTION_CACHE_SECONDS=60
TEMP_DIR=./data/tmp

# Исполняемые файлы должны быть в PATH либо укажите полные пути.
# Windows: YT_DLP_PATH=C:/Tools/yt-dlp/yt-dlp.exe
# FFmpeg и ffprobe должны лежать в одном каталоге.
YT_DLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
TELEGRAM_API_ROOT=https://api.telegram.org
